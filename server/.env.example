DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ruobai
SESSION_SECRET=change-this-to-a-random-string
PORT=3000
# 首次初始化数据库时创建的管理员（只在库里还没有管理员时生效）
# 不填会随机生成一个，并在初始化日志里只显示一次；Docker 部署由安装脚本自动生成。
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
CORS_ORIGINS=https://example.com,https://www.example.com,http://localhost:3000,http://127.0.0.1:3000,https://localhost,capacitor://localhost
SESSION_COOKIE_CROSS_SITE=false
BETA_REGISTRATION_ENABLED=true
OPEN_SOURCE_SINGLE_USER=false
REGISTRATION_INVITE_CODE=
REGISTRATION_NOTE=
PROACTIVE_PUSH_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_PATH=

# 可选：不走“我的 → 她的能力”渠道时，使用服务端默认火山实时通话配置
VOLC_REALTIME_API_KEY=
VOLC_REALTIME_URL=wss://openspeech.bytedance.com/api/v3/realtime/dialogue
VOLC_REALTIME_MODEL=2.2.0.0
VOLC_REALTIME_SPEAKER=saturn_zh_female_wenrouwenya_tob

# 可选：私有关系配置的绝对路径（不进 Git；不填则用代码内通用默认值）
XIAOBAI_PRIVATE_CONFIG=
